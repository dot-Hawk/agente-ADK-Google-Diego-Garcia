# Copiar este archivo como .env (en esta misma carpeta) y completar.
# Modelo en formato LiteLLM: proveedor/modelo
MODELO=gemini/gemini-2.5-flash
GEMINI_API_KEY=tu_api_key_aca
ADK_SUPPRESS_GEMINI_LITELLM_WARNINGS=true

# Alternativas:
# MODELO=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=...
# MODELO=ollama_chat/llama3.1   (local, sin API key)
